menu "YouTube Sticky"

    config YOUTUBE_WIFI_SSID
      string "Wi-Fi SSID"
      default ""
      help
          Wi-Fi network used by the Sticky to reach YouTube directly.

    config YOUTUBE_WIFI_PASSWORD
      string "Wi-Fi password"
      default ""

    config YOUTUBE_API_KEY
      string "YouTube Data API key"
      default ""
      help
          Optional developer-build default. Do not commit a personal API key; generic builds should use the first-boot setup page.

    config YOUTUBE_CHANNEL
      string "YouTube channel ID or @handle"
      default "@PBJSquad"

    endmenu
